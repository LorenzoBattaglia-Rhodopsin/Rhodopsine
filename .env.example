# URL pubblico del sito (usato per canonical, Open Graph, sitemap, robots).
# In sviluppo va bene http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://rhodopsine.com

# Token di verifica proprietà del sito per Google Search Console.
# Inserire SOLO il valore del "content" del meta tag (non il tag intero).
# Se vuoto, il meta tag non viene emesso.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Dominio per le statistiche privacy-first e cookieless (Plausible).
# Es. rhodopsine.com — se vuoto, nessuno script di analytics viene caricato.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ID misurazione di Google Analytics 4 (formato G-XXXXXXXXXX).
# Lo trovi in GA4 → Amministrazione → Stream di dati → Web.
# Se vuoto, né GA4 né il banner di consenso Iubenda vengono caricati.
# NB: GA4 usa cookie → si carica solo previo consenso (banner Iubenda).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
